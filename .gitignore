.DS_Store

# episode videos — large binaries, kept out of git history
*.mp4

# scratch copies of superseded tile GLBs — kept on disk, out of history
*.glb.bak

# python bytecode from tools/
__pycache__/

# Claude Code's own working directory: local settings and session state, plus the symlinks
# that claude-skills/link-skills.sh puts there. All of it is per-machine — the skills
# themselves are versioned in claude-skills/.
.claude/

# Skill virtualenvs: board-tile-art's is 67 MB of platform-specific binaries, rebuilt by
# its own setup.sh.
claude-skills/*/.venv/
