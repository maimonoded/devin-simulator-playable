.DS_Store

# episode videos — large binaries, kept out of git history
*.mp4

# scratch copies of superseded tile GLBs — kept on disk, out of history
*.glb.bak

# python bytecode from tools/
__pycache__/

# Claude Code's project directory is mostly local state — personal settings, session
# scratch — but .claude/skills holds the asset pipeline this repo's environment art
# depends on, and that belongs to everyone working here.
#
# Excluding the CONTENTS rather than .claude itself is deliberate: git cannot re-include
# anything under a directory it has already excluded, so `.claude/` followed by a negation
# would silently ignore the skills too.
.claude/*
!.claude/skills/
